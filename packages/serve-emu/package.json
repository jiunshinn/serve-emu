{
  "name": "serve-emu",
  "version": "0.1.0",
  "description": "The `npx serve` of Android devices — stream a booted emulator or attached device over a WebSocket H.264 feed decoded in the browser with WebCodecs.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "jiunshinn",
  "homepage": "https://github.com/jiunshinn/serve-emu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiunshinn/serve-emu.git",
    "directory": "packages/serve-emu"
  },
  "bugs": {
    "url": "https://github.com/jiunshinn/serve-emu/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "adb",
    "scrcpy",
    "screen-mirror",
    "remote-control",
    "h264",
    "webcodecs",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "bin": {
    "serve-emu": "src/cli.ts"
  },
  "exports": {},
  "scripts": {
    "setup": "bun run scripts/fetch-scrcpy.ts && bun run build:ui",
    "dev": "bun --watch run src/cli.ts",
    "dev:ui": "vite",
    "start": "bun run src/cli.ts",
    "build:ui": "vite build",
    "build": "bun run build:ui",
    "docs:sync": "bun run scripts/sync-readme.ts --write",
    "docs:check": "bun run scripts/sync-readme.ts --check",
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage && bun run scripts/check-coverage.ts",
    "test:package": "bun run scripts/package-smoke.ts",
    "check:unused": "knip",
    "check:unused:prod": "knip --production --include files",
    "check": "bun run docs:check && bun run check:unused:prod && bun run check:unused && bun run coverage && bun run typecheck && bun run typecheck:ui && bun run typecheck:tests && bun run build && bun run test:package",
    "release": "bun run scripts/release.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p src/ui --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "prepack": "bun run scripts/fetch-scrcpy.ts",
    "prepublishOnly": "bun run check",
    "test:browser": "playwright test"
  },
  "files": [
    "src",
    "!src/ui",
    "scripts/fetch-scrcpy.ts",
    "vendor/scrcpy-server-v4.0",
    "dist/ui",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@fastify/busboy": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "knip": "6.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
